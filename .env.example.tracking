/**
 * ENVIRONMENT VARIABLES GUIDE for Journey Tracking Features
 * 
 * Copy this content to your .env or .env.local file
 * and fill in the actual values
 */

// Google Maps API Key
// Required for MapView component to work
// Get it from: https://console.cloud.google.com/
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

// OpenRouteService (ORS) API Key
// Already configured in utils/routeUtils.ts
// Get it from: https://openrouteservice.org/
// Note: The ORS API key is embedded in the routeUtils.ts file
// If you need to make it configurable, create an env variable and update routeUtils.ts

// Backend API URL
EXPO_PUBLIC_API_URL=https://your-api-url/api/v1/

// AI API URL (if using AI features)
EXPO_PUBLIC_AI_API_URL=https://your-ai-api-url/api/v1/

// API Timeout (milliseconds)
EXPO_PUBLIC_API_TIMEOUT=300000
