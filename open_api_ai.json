e":"string"},"type":"array"},{"type":"null"}],"title":"Place Ids","description":"Specific place IDs to plan. If empty, AI will suggest from all places."}},"type":"object","required":["total_budget_vnd","daily_budget_vnd"],"title":"AIPlanRequest","description":"Request body for AI itinerary planning.","examples":[{"daily_budget_vnd":1200000,"exclude_categories":["NIGHTLIFE"],"max_places_per_day":4,"mode":"solo","mood":"NATURE_EXPLORE","must_include_categories":["ATTRACTION","CAFE"],"total_budget_vnd":7000000,"travel_style":"balanced"},{"daily_budget_vnd":1500000,"max_places_per_day":5,"mode":"group","mood_distribution":{"CHILL_CAFE":0.2,"FOOD_LOCAL":0.2,"NATURE_EXPLORE":0.3,"RESET_HEALING":0.3},"requester_user_id":"owner_001","total_budget_vnd":9000000,"travel_style":"sightseeing"}]},"AIPlanResponse":{"properties":{"journey_id":{"type":"string","title":"Journey Id"},"journey_name":{"type":"string","title":"Journey Name"},"total_days":{"type":"integer","title":"Total Days"},"mode":{"type":"string","enum":["solo","group"],"title":"Mode"},"mood_used":{"anyOf":[{"type":"string","enum":["RESET_HEALING","CHILL_CAFE","NATURE_EXPLORE","FOOD_LOCAL"]},{"type":"null"}],"title":"Mood Used"},"mood_distribution_used":{"anyOf":[{"additionalProperties":{"type":"number"},"propertyNames":{"enum":["RESET_HEALING","CHILL_CAFE","NATURE_EXPLORE","FOOD_LOCAL"]},"type":"object"},{"type":"null"}],"title":"Mood Distribution Used"},"total_budget_vnd":{"type":"integer","title":"Total Budget Vnd"},"daily_budget_vnd":{"type":"integer","title":"Daily Budget Vnd"},"generated_at":{"type":"string","format":"date-time","title":"Generated At"},"candidate_pool_size":{"type":"integer","title":"Candidate Pool Size"},"generation_time_ms":{"type":"integer","title":"Generation Time Ms"},"hotel_name":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Hotel Name"},"accommodation_cost_vnd":{"type":"integer","title":"Accommodation Cost Vnd","default":0},"num_nights":{"type":"integer","title":"Num Nights","default":0},"days":{"items":{"$ref":"#/components/schemas/AIDayPlan"},"type":"array","title":"Days"},"candidate_pool":{"items":{"$ref":"#/components/schemas/AICandidatePlace"},"type":"array","title":"Candidate Pool"},"planning_notes":{"items":{"type":"string"},"type":"array","title":"Planning Notes"},"algorithm_version":{"type":"string","title":"Algorithm Version","default":"1.0.0"}},"type":"object","required":["journey_id","journey_name","total_days","mode","total_budget_vnd","daily_budget_vnd","generated_at","candidate_pool_size","generation_time_ms","days","planning_notes"],"title":"AIPlanResponse","description":"Response from AI planning endpoint."},"AIStopExplanation":{"properties":{"place_id":{"type":"string","title":"Place Id"},"place_name":{"type":"string","title":"Place Name"},"day_number":{"type":"integer","title":"Day Number"},"final_score":{"type":"number","title":"Final Score"},"mood_score_breakdown":{"additionalProperties":{"type":"number"},"type":"object","title":"Mood Score Breakdown"},"why_selected":{"type":"string","title":"Why Selected"},"category":{"type":"string","title":"Category"},"rating":{"type":"number","title":"Rating"},"estimated_cost_vnd":{"type":"integer","title":"Estimated Cost Vnd"}},"type":"object","required":["place_id","place_name","day_number","final_score","why_selected","category","rating","estimated_cost_vnd"],"title":"AIStopExplanation","description":"Per-stop explanation of why a place was selected."},"AIStopSuggestion":{"properties":{"place_id":{"type":"string","title":"Place Id"},"place_name":{"type":"string","title":"Place Name"},"estimated_duration_minutes":{"type":"integer","title":"Estimated Duration Minutes"},"reason":{"type":"string","title":"Reason"},"order":{"type":"integer","title":"Order"},"travel_time_from_previous_minutes":{"type":"integer","title":"Travel Time From Previous Minutes","default":0},"distance_from_previous_km":{"type":"number","title":"Distance From Previous Km","default":0.0},"latitude":{"type":"numb