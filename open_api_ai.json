{"openapi":"3.1.0","info":{"title":"Travel Backend API","summary":"AI-assisted travel planning API","description":"\n    ## Travel Application Backend with AI-Assisted Itinerary Planning\n    \n    This API provides endpoints for:\n    \n    ### Places\n    - List and search places\n    - Get place details\n    - Find nearby places (geospatial)\n    \n    ### Journeys\n    - Get journey details\n    - **AI-powered itinerary planning**\n    - Manual stop management\n    \n    ### AI Planning Features\n    \n    The AI planning system is **deterministic and explainable**:\n    - Uses Haversine formula for distance calculation\n    - Groups nearby places into same day\n    - Optimizes route order using nearest neighbor algorithm\n    - Adjusts for travel style (sightseeing/relaxing/balanced)\n\n    ","contact":{"name":"Travel Backend Team","url":"https://example.com/support"},"license":{"name":"Proprietary"},"version":"1.0.0"},"servers":[{"url":"/","description":"Current environment"}],"paths":{"/api/v1/places":{"get":{"tags":["Places"],"summary":"Get all places","description":"Get list of all approved places with optional filtering","operationId":"get_places_api_v1_places_get","parameters":[{"name":"category","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"Filter by category: ATTRACTION, HOTEL, RESTAURANT","title":"Category"},"description":"Filter by category: ATTRACTION, HOTEL, RESTAURANT"},{"name":"limit","in":"query","required":false,"schema":{"type":"integer","maximum":200,"minimum":1,"description":"Maximum number of results","default":50,"title":"Limit"},"description":"Maximum number of results"}],"responses":{"200":{"description":"List of approved places","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/v1/places/{place_id}":{"get":{"tags":["Places"],"summary":"Get place details","description":"Get detailed information about a specific place","operationId":"get_place_api_v1_places__place_id__get","parameters":[{"name":"place_id","in":"path","required":true,"schema":{"type":"string","description":"Place ID (Mongo ObjectId as string)","examples":["67fd123abc9876543210f222"],"title":"Place Id"},"description":"Place ID (Mongo ObjectId as string)"}],"responses":{"200":{"description":"Complete place document","content":{"application/json":{"schema":{}}}},"404":{"description":"Place not found"},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/v1/places/nearby/search":{"get":{"tags":["Places"],"summary":"Find nearby places","description":"Find places near a geographic point","operationId":"find_nearby_places_api_v1_places_nearby_search_get","parameters":[{"name":"longitude","in":"query","required":true,"schema":{"type":"number","maximum":180,"minimum":-180,"description":"Center point longitude","examples":[108.2208],"title":"Longitude"},"description":"Center point longitude"},{"name":"latitude","in":"query","required":true,"schema":{"type":"number","maximum":90,"minimum":-90,"description":"Center point latitude","examples":[16.0544],"title":"Latitude"},"description":"Center point latitude"},{"name":"max_distance","in":"query","required":false,"schema":{"type":"integer","maximum":50000,"minimum":100,"description":"Max distance in meters","examples":[3000],"default":5000,"title":"Max Distance"},"description":"Max distance in meters"}],"responses":{"200":{"description":"Nearby places sorted by proximity","content":{"application/json":{"schema":{}}}},"500":{"description":"Geospatial query failed or missing 2dsphere index"},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/v1/places/enrich-scores":{"post":{"tags":["Places"],"summary":"Estimate and enrich missing healing/crowd scores","description":"Uses rule-based heuristics to infer healing_score and crowd_level for places that lack them.","operationId":"enrich_place_scores_api_v1_places_enrich_scores_post","parameters":[{"name":"dry_run","in":"query","required":false,"schema":{"type":"boolean","description":"If true, returns what WOULD be enriched without modifying DB","examples":[true],"default":false,"title":"Dry Run"},"description":"If true, returns what WOULD be enriched without modifying DB"}],"responses":{"200":{"description":"Summary of updated and skipped places","content":{"application/json":{"schema":{}}}},"500":{"description":"Enrichment process failed"},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/v1/journeys":{"get":{"tags":["Journeys"],"summary":"List recent journeys","description":"List recent journeys to quickly discover valid journey IDs","operationId":"list_journeys_api_v1_journeys_get","parameters":[{"name":"limit","in":"query","required":false,"schema":{"type":"integer","maximum":100,"minimum":0,"default":20,"title":"Limit"}}],"responses":{"200":{"description":"Array of recent journeys with compact metadata","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/v1/journeys/{journey_id}":{"get":{"tags":["Journeys"],"summary":"Get journey details","description":"Get full journey details including all days and stops","operationId":"get_journey_api_v1_journeys__journey_id__get","parameters":[{"name":"journey_id","in":"path","required":true,"schema":{"type":"string","description":"Journey ID (Mongo ObjectId as string)","examples":["67fd123abc9876543210f111"],"title":"Journey Id"},"description":"Journey ID (Mongo ObjectId as string)"}],"responses":{"200":{"description":"Full journey document including days and stops","content":{"application/json":{"schema":{}}}},"404":{"description":"Journey not found"},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}},"delete":{"tags":["Journeys"],"summary":"Delete a journey","description":"Delete a journey completely from the database","operationId":"delete_journey_api_v1_journeys__journey_id__delete","parameters":[{"name":"journey_id","in":"path","required":true,"schema":{"type":"string","description":"Journey ID (Mongo ObjectId as string)","examples":["67fd123abc9876543210f111"],"title":"Journey Id"},"description":"Journey ID (Mongo ObjectId as string)"}],"responses":{"200":{"description":"Deletion confirmation","content":{"application/json":{"schema":{}}}},"404":{"description":"Journey not found"},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/v1/journeys/{journey_id}/days/{day_number}/stops/{place_id}":{"post":{"tags":["Journeys"],"summary":"Add a stop to a day","description":"Manually add a place to a specific day in the journey","operationId":"add_stop_to_day_api_v1_journeys__journey_id__days__day_number__stops__place_id__post","parameters":[{"name":"journey_id","in":"path","required":true,"schema":{"type":"string","description":"Journey ID (Mongo ObjectId as string)","examples":["67fd123abc9876543210f111"],"title":"Journey Id"},"description":"Journey ID (Mongo ObjectId as string)"},{"name":"day_number","in":"path","required":true,"schema":{"type":"integer","minimum":1,"description":"Day index in the journey","examples":[1],"title":"Day Number"},"description":"Day index in the journey"},{"name":"place_id","in":"path","required":true,"schema":{"type":"string","description":"Place ID to add","examples":["67fd123abc9876543210f222"],"title":"Place Id"},"description":"Place ID to add"}],"responses":{"200":{"description":"Confirmation that stop was added","content":{"application/json":{"schema":{}}}},"400":{"description":"Day not found in journey"},"404":{"description":"Journey or place not found"},"500":{"description":"Failed to add stop"},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}},"delete":{"tags":["Journeys"],"summary":"Remove a stop from a day","description":"Remove a place from a specific day in the journey","operationId":"remove_stop_from_day_api_v1_journeys__journey_id__days__day_number__stops__place_id__delete","parameters":[{"name":"journey_id","in":"path","required":true,"schema":{"type":"string","description":"Journey ID (Mongo ObjectId as string)","examples":["67fd123abc9876543210f111"],"title":"Journey Id"},"description":"Journey ID (Mongo ObjectId as string)"},{"name":"day_number","in":"path","required":true,"schema":{"type":"integer","minimum":1,"description":"Day index in the journey","examples":[1],"title":"Day Number"},"description":"Day index in the journey"},{"name":"place_id","in":"path","required":true,"schema":{"type":"string","description":"Place ID to remove","examples":["67fd123abc9876543210f222"],"title":"Place Id"},"description":"Place ID to remove"}],"responses":{"200":{"description":"Confirmation that stop was removed","content":{"application/json":{"schema":{}}}},"500":{"description":"Failed to remove stop"},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/v1/journeys/auto-create-related":{"post":{"tags":["AI Planning"],"summary":"Create a new journey from related places","description":"Create a journey from related places and optionally auto-generate day plans.\n\n    Related place selection strategy:\n    - If `seed_place_id` is provided: prioritize nearby places and same-category places\n    - Always merge with top approved places as fallback\n    - Rank by rating, review count, category match, and tag overlap\n\n    This endpoint does not require any database schema changes.","operationId":"create_journey_from_related_places_api_v1_journeys_auto_create_related_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateJourneyFromRelatedRequest"}}},"required":true},"responses":{"201":{"description":"Journey identifier plus optional auto-generated day plans","content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateJourneyFromRelatedResponse"}}}},"400":{"description":"Invalid date range or request constraints"},"404":{"description":"Seed place not found"},"500":{"description":"Journey creation failed"},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/v1/journeys/{journey_id}/ai-plan":{"post":{"tags":["AI Planning"],"summary":"Generate AI-powered itinerary","description":"Generate an AI-powered itinerary for a journey.\n    \n    The AI will:\n    - Analyze selected places\n    - Calculate optimal routes using Haversine distance\n    - Group nearby places into the same day\n    - Optimize visit order within each day\n    - Adjust durations based on travel style\n    \n    Travel styles:\n    - **sightseeing**: More stops, shorter durations\n    - **relaxing**: Fewer stops, longer durations  \n    - **balanced**: Moderate pace","operationId":"generate_ai_plan_api_v1_journeys__journey_id__ai_plan_post","parameters":[{"name":"journey_id","in":"path","required":true,"schema":{"type":"string","description":"Journey ID (Mongo ObjectId as string)","examples":["67fd123abc9876543210f111"],"title":"Journey Id"},"description":"Journey ID (Mongo ObjectId as string)"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/AIPlanRequest"}}}},"responses":{"200":{"description":"Generated itinerary and planning diagnostics","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AIPlanResponse"}}}},"400":{"description":"Invalid request parameters or missing planning data"},"403":{"description":"Only journey owner can regenerate in group mode"},"404":{"description":"Journey not found"},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/v1/journeys/{journey_id}/ai-explain":{"get":{"tags":["AI Planning"],"summary":"Get AI planning explanation","description":"Get a detailed, journey-specific explanation of how this itinerary was built.\n\n    This endpoint re-analyses the journey's saved stops and returns:\n    - **Per-stop reasoning** — why each place was selected (score, mood match, proximity)\n    - **Improvement suggestions** — budget headroom, missing food stops, long travel days, etc.\n    - **Algorithm transparency** — constraints, style config, and selection criteria used\n\n    The analysis is read-only; no changes are made to the journey.","operationId":"get_ai_explanation_api_v1_journeys__journey_id__ai_explain_get","parameters":[{"name":"journey_id","in":"path","required":true,"schema":{"type":"string","description":"Journey ID (Mongo ObjectId as string)","examples":["67fd123abc9876543210f111"],"title":"Journey Id"},"description":"Journey ID (Mongo ObjectId as string)"}],"responses":{"200":{"description":"Journey-specific explanation of planning decisions and improvement tips","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AIExplanation"}}}},"404":{"description":"Journey not found"},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/v1/journeys/{journey_id}/days/{day_number}/improve-route-order":{"post":{"tags":["AI Planning"],"summary":"Improve route order only","description":"Reorder existing day stops to reduce distance without regenerating itinerary","operationId":"improve_route_order_only_api_v1_journeys__journey_id__days__day_number__improve_route_order_post","parameters":[{"name":"journey_id","in":"path","required":true,"schema":{"type":"string","description":"Journey ID (Mongo ObjectId as string)","examples":["67fd123abc9876543210f111"],"title":"Journey Id"},"description":"Journey ID (Mongo ObjectId as string)"},{"name":"day_number","in":"path","required":true,"schema":{"type":"integer","minimum":1,"description":"Day index within the journey","examples":[1],"title":"Day Number"},"description":"Day index within the journey"}],"responses":{"200":{"description":"Distance comparison before/after reordering","content":{"application/json":{"schema":{}}}},"400":{"description":"Day not found in journey"},"404":{"description":"Journey not found"},"500":{"description":"Failed to persist reordered stops"},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/debug":{"get":{"tags":["Debug"],"summary":"Debug UI","operationId":"debug_ui_debug_get","responses":{"200":{"description":"Successful Response","content":{"text/html":{"schema":{"type":"string"}}}}}}},"/":{"get":{"tags":["Health"],"summary":"API root","description":"Root endpoint - Health check.","operationId":"root__get","responses":{"200":{"description":"Basic service metadata and docs link","content":{"application/json":{"schema":{}}}}}}},"/health":{"get":{"tags":["Health"],"summary":"Health check","description":"Detailed health check endpoint.","operationId":"health_check_health_get","responses":{"200":{"description":"Basic health status for API and database connectivity","content":{"application/json":{"schema":{}}}}}}}},"components":{"schemas":{"AICandidatePlace":{"properties":{"place_id":{"type":"string","title":"Place Id"},"place_name":{"type":"string","title":"Place Name"},"category":{"type":"string","title":"Category"},"rating":{"type":"number","title":"Rating"},"estimated_cost_vnd":{"type":"integer","title":"Estimated Cost Vnd"},"final_score":{"type":"number","title":"Final Score"},"mood_score_breakdown":{"additionalProperties":{"type":"number"},"type":"object","title":"Mood Score Breakdown"},"reasoning":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Reasoning"},"selected":{"type":"boolean","title":"Selected","default":false}},"type":"object","required":["place_id","place_name","category","rating","estimated_cost_vnd","final_score"],"title":"AICandidatePlace","description":"A place evaluated by the AI for inclusion."},"AIDayPlan":{"properties":{"day_number":{"type":"integer","title":"Day Number"},"date":{"type":"string","format":"date-time","title":"Date"},"stops":{"items":{"$ref":"#/components/schemas/AIStopSuggestion"},"type":"array","title":"Stops"},"total_duration_minutes":{"type":"integer","title":"Total Duration Minutes"},"total_travel_time_minutes":{"type":"integer","title":"Total Travel Time Minutes"},"total_estimated_cost_vnd":{"type":"integer","title":"Total Estimated Cost Vnd"},"total_distance_km":{"type":"number","title":"Total Distance Km"},"spent_today":{"type":"integer","title":"Spent Today"},"remaining_today":{"type":"integer","title":"Remaining Today"},"saved_vs_budget":{"type":"integer","title":"Saved Vs Budget"},"explanations":{"items":{"type":"string"},"type":"array","title":"Explanations"},"summary":{"type":"string","title":"Summary"},"weather":{"anyOf":[{"additionalProperties":true,"type":"object"},{"type":"null"}],"title":"Weather"}},"type":"object","required":["day_number","date","stops","total_duration_minutes","total_travel_time_minutes","total_estimated_cost_vnd","total_distance_km","spent_today","remaining_today","saved_vs_budget","summary"],"title":"AIDayPlan","description":"AI-generated day plan with metadata."},"AIExplanation":{"properties":{"journey_id":{"type":"string","title":"Journey Id"},"algorithm_description":{"type":"string","title":"Algorithm Description"},"distance_calculation":{"type":"string","title":"Distance Calculation"},"grouping_strategy":{"type":"string","title":"Grouping Strategy"},"style_adjustments":{"additionalProperties":true,"type":"object","title":"Style Adjustments"},"constraints_applied":{"items":{"type":"string"},"type":"array","title":"Constraints Applied"},"place_selection_criteria":{"items":{"type":"string"},"type":"array","title":"Place Selection Criteria"},"journey_stats":{"additionalProperties":true,"type":"object","title":"Journey Stats","description":"High-level trip statistics"},"stop_explanations":{"items":{"$ref":"#/components/schemas/AIStopExplanation"},"type":"array","title":"Stop Explanations","description":"Per-stop selection reasoning"},"improvement_suggestions":{"items":{"$ref":"#/components/schemas/AIImprovementSuggestion"},"type":"array","title":"Improvement Suggestions","description":"Actionable improvement tips"},"reason_codes":{"items":{"type":"string"},"type":"array","title":"Reason Codes"},"planning_notes":{"items":{"type":"string"},"type":"array","title":"Planning Notes"}},"type":"object","required":["journey_id","algorithm_description","distance_calculation","grouping_strategy","style_adjustments","constraints_applied","place_selection_criteria"],"title":"AIExplanation","description":"Detailed explanation of AI planning decisions."},"AIImprovementSuggestion":{"properties":{"type":{"type":"string","title":"Type"},"message":{"type":"string","title":"Message"}},"type":"object","required":["type","message"],"title":"AIImprovementSuggestion","description":"A concrete improvement suggestion for the current itinerary."},"AIPlanRequest":{"properties":{"total_days":{"anyOf":[{"type":"integer","minimum":1.0},{"type":"null"}],"title":"Total Days","description":"Optional guardrail. Must match journey date range when provided."},"total_budget_vnd":{"type":"integer","minimum":0.0,"title":"Total Budget Vnd","description":"Total trip budget in VND","examples":[7000000]},"daily_budget_vnd":{"type":"integer","minimum":0.0,"title":"Daily Budget Vnd","description":"Daily budget cap in VND","examples"